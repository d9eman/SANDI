+document.addEventListener("click", (event) => {
+  const button = event.target.closest("[data-use-location]");
+  if (!button) return;
+  const target = document.querySelector(button.dataset.useLocation);
+  if (!target || !navigator.geolocation) {
+    window.alert("Location access is not available in this browser. Enter a ZIP code, city, or address instead.");
+    return;
+  }
+  const original = button.textContent;
+  button.disabled = true;
+  button.textContent = "Getting location…";
+  navigator.geolocation.getCurrentPosition(
+    ({ coords }) => {
+      target.value = `${coords.latitude.toFixed(6)},${coords.longitude.toFixed(6)}`;
+      button.textContent = "Location added";
+      setTimeout(() => { button.textContent = original; button.disabled = false; }, 1600);
+    },
+    () => {
+      window.alert("Location was not shared. You can enter a ZIP code, city, or address.");
+      button.textContent = original;
+      button.disabled = false;
+    },
+    { enableHighAccuracy: false, timeout: 8000, maximumAge: 300000 }
+  );
+});
