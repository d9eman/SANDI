+{% extends "base.html" %}
+{% block title %}Create eligibility profile | SANDI Demo{% endblock %}
+{% block content %}
+<section class="narrow-page">
+  <p class="eyebrow">Optional reusable profile</p>
+  <h1>Check several programs without repeating the same questions.</h1>
+  <p class="lede">You do not need to provide a name, phone number, email, or ID. You can stop at any time and keep your place.</p>
+  {% if prefill_zip %}<div class="notice success"><strong>We will reuse ZIP {{ prefill_zip }}.</strong> You entered it in the food finder, so SANDI will not ask again unless you choose to edit it.</div>{% endif %}
+  <form method="post" action="/start" class="card stack">
+    <input type="hidden" name="csrf" value="{{ csrf_token }}">
+    <input type="hidden" name="need" value="food">
+    <input type="hidden" name="source" value="{{ source }}">
+    <label>Preferred language
+      <select name="language"><option value="en">English</option><option value="es">Español</option></select>
+    </label>
+    <fieldset>
+      <legend>Is anyone in immediate danger or having a medical emergency?</legend>
+      <label class="choice"><input type="radio" name="danger" value="no" checked> No</label>
+      <label class="choice"><input type="radio" name="danger" value="yes"> Yes</label>
+    </fieldset>
+    <button class="button primary" type="submit">Create my guest profile</button>
+  </form>
+  <p class="field-note">This demo performs pre-screening only. The responsible agency or provider makes the official decision.</p>
+</section>
+{% endblock %}
