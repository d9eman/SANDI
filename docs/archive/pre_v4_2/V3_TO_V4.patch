+
+/* v4: two intentionally separate journeys and progressive disclosure */
+.compact-hero { max-width: 920px; margin-bottom: 28px; }
+.compact-heading { margin-bottom: 26px; }
+.compact-heading h1 { max-width: 19ch; }
+.simple-process { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px; margin-top:30px; }
+.simple-process > div { border-top:1px solid var(--line); padding-top:16px; }
+.simple-process span { display:inline-grid; place-items:center; width:30px; height:30px; border-radius:50%; background:var(--green-soft); color:var(--green); font-weight:900; margin-bottom:8px; }
+.simple-process strong { display:block; }
+.simple-process p { color:var(--muted); margin:.35rem 0 0; }
+.location-search-v4 { margin-bottom:28px; }
+.urgency-row { display:flex; flex-wrap:wrap; gap:8px 18px; margin-top:6px; }
+.compact-choice { padding:4px 0; }
+.map-badge { background:var(--green-soft); color:var(--green); }
+.compact-section-heading { margin-top:30px; align-items:start; }
+.compact-section-heading > p { max-width:52ch; color:var(--muted); }
+.local-site-note { padding:12px 0 6px; }
+.optional-resources { margin-top:24px; }
+.optional-resources > summary, .other-results > summary, .why-details > summary { cursor:pointer; font-weight:850; color:var(--blue); }
+.compact-resource-list { display:grid; gap:10px; margin-top:16px; }
+.compact-resource-list > div { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr) auto; gap:12px; padding-top:10px; border-top:1px solid var(--line); }
+.compact-resource-list span { color:var(--muted); }
+.next-step-card { margin-top:34px; display:flex; justify-content:space-between; gap:28px; align-items:center; background:var(--green-soft); border-color:#c5e4d8; }
+.next-step-card > div:first-child { max-width:62ch; }
+.narrow-page { max-width:680px; margin-inline:auto; }
+.simplified-question-layout { grid-template-columns:minmax(0,1fr) 280px; }
+.question-card { margin-top:22px; }
+.progress-panel { position:sticky; top:100px; }
+.progress-panel a { display:block; margin-top:10px; }
+.progress-number { font-size:3rem; line-height:1; color:var(--green); }
+.match-alert { background:var(--green-soft); border:1px solid #b9ddcd; border-radius:var(--radius); padding:20px; margin-bottom:28px; }
+.match-alert p { margin:.5rem 0; }
+.compact-actions { gap:8px; margin-top:12px; }
+.compact-actions .button { padding:8px 12px; }
+.result-grid { display:grid; gap:16px; }
+.results-section { margin-top:34px; }
+.result-card { padding:22px; box-shadow:none; }
+.result-card h3 { font-size:1.18rem; margin-bottom:8px; }
+.result-likely_eligible, .result-direct_resource { border-left:6px solid var(--green); }
+.result-may_qualify, .result-needs_information { border-left:6px solid var(--gold); }
+.result-likely_not_eligible { border-left:6px solid var(--red); }
+.result-rule_under_review { border-left:6px solid var(--muted); }
+.missing-answers { background:var(--gold-soft); border-radius:10px; padding:12px; margin-top:16px; }
+.answer-chip { display:inline-flex; margin:8px 6px 0 0; padding:6px 10px; border:1px solid #d7b76f; border-radius:999px; background:white; text-decoration:none; font-size:.86rem; }
+.why-details { margin-top:16px; border-top:1px solid var(--line); padding-top:14px; }
+.requirement-list { display:grid; gap:12px; margin-top:16px; }
+.requirement-row { border:1px solid var(--line); border-radius:10px; padding:14px; }
+.requirement-pass { background:#f4fbf8; }
+.requirement-fail { background:#fff7f7; border-color:#e6baba; }
+.requirement-unknown { background:#fffaf0; border-color:#e7d3a4; }
+.requirement-heading { display:flex; gap:10px; flex-wrap:wrap; align-items:center; }
+.requirement-state { font-size:.75rem; text-transform:uppercase; letter-spacing:.05em; font-weight:900; }
+.requirement-pass .requirement-state { color:var(--green); }
+.requirement-fail .requirement-state { color:var(--red); }
+.requirement-unknown .requirement-state { color:var(--gold); }
+.comparison-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; margin:12px 0 0; }
+.comparison-grid div { background:white; border:1px solid var(--line); border-radius:8px; padding:10px; }
+.comparison-grid dt { font-size:.78rem; color:var(--muted); text-transform:uppercase; font-weight:850; }
+.comparison-grid dd { margin:4px 0 0; font-weight:700; }
+.source-details { margin-top:14px; }
+.other-results { border-top:1px solid var(--line); padding-top:18px; }
+.other-results > summary { margin-bottom:16px; }
+.compact-next-step { background:white; }
+.error-text { color:var(--red); font-weight:700; }
+.compact-details div { grid-template-columns:130px 1fr; }
+
+@media (max-width:850px) {
+  .simple-process, .simplified-question-layout { grid-template-columns:1fr; }
+  .progress-panel { position:static; }
+  .next-step-card { align-items:flex-start; flex-direction:column; }
+  .compact-resource-list > div { grid-template-columns:1fr; gap:4px; }
+}
+@media (max-width:620px) {
+  .comparison-grid { grid-template-columns:1fr; }
+  .urgency-row { display:grid; }
+}
